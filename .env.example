# ═══════════════════════════════════════════════════════════════════════════════
# SunuFarmasi API - Variables d'environnement PRODUCTION
# ═══════════════════════════════════════════════════════════════════════════════
# COPIER ce fichier en .env et remplir les vraies valeurs.
# Ne jamais committer .env dans git !
# ═══════════════════════════════════════════════════════════════════════════════

# ── Base de données PostgreSQL ────────────────────────────────────────────────
DB_NAME=sunufarmasi
DB_USERNAME=sunufarmasi
DB_PASSWORD=CHANGER_MOI_DB_PASSWORD_FORT

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGER_MOI_REDIS_PASSWORD_FORT

# ── JWT Secret ───────────────────────────────────────────────────────────────
# Générer avec: openssl rand -base64 64
JWT_SECRET=CHANGER_MOI_GENERER_AVEC_openssl_rand_base64_64
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=2592000000

# ── Email / SMTP (pour envoi OTP) ─────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=votre.email@gmail.com
MAIL_PASSWORD=votre_app_password_gmail

# ── CORS - Domaines autorisés ─────────────────────────────────────────────────
# Dashboard Firebase
CORS_ORIGIN_DASH=https://app-sunufarmasi.web.app
CORS_ORIGIN_DASH_ALT=https://app-sunufarmasi.firebaseapp.com
# Landing page Firebase
CORS_ORIGIN_LANDING=https://sunufarmasi-landingpage.web.app
# Domaine custom (si vous avez un domaine)
CORS_ORIGIN_CUSTOM=https://sunufarmasi.sn

# ── Initialisation des données ────────────────────────────────────────────────
# Mettre à true UNIQUEMENT pour le 1er déploiement (seed des données de base)
# Remettre à false après l'initialisation !
APP_INIT_ENABLED=false

# ── Serveur ───────────────────────────────────────────────────────────────────
PORT=8080
LOG_PATH=/var/log/sunufarmasi
