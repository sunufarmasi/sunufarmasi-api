# ═══════════════════════════════════════════════════════════════════════════════
# SunuFarmasi API - Variables d'environnement PRODUCTION
# Sur le serveur Debian : /opt/sunufarmasi/.env
# Permissions : chmod 600 /opt/sunufarmasi/.env (lecture par root + user sunufarmasi seulement)
# ═══════════════════════════════════════════════════════════════════════════════

# ── Base de données PostgreSQL ────────────────────────────────────────────────
DATABASE_URL=jdbc:postgresql://localhost:5432/sunufarmasi
DB_USERNAME=sunufarmasi
DB_PASSWORD=CHANGER_MOI_avec_mot_de_passe_fort

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGER_MOI_redis_password

# ── JWT Secret ───────────────────────────────────────────────────────────────
# Générer sur le serveur avec : openssl rand -base64 64
JWT_SECRET=CHANGER_MOI_generer_avec_openssl_rand_base64_64
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=2592000000

# ── Email / SMTP (pour envoi OTP par email) ───────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=sunufarmasi@gmail.com
MAIL_PASSWORD=khli sqqj orji obho

# ── CORS - Domaines autorisés (virgule-séparée, pas d'espace) ────────────────
CORS_ORIGINS=https://app-sunufarmasi.web.app,https://app-sunufarmasi.firebaseapp.com,https://sunufarmasi-landingpage.web.app,https://sunufarmasi.sn

# ── Port API ──────────────────────────────────────────────────────────────────
PORT=8080
LOG_PATH=/var/log/sunufarmasi

# ── Init données (true SEULEMENT pour le 1er démarrage, remettre false ensuite) ─
APP_INIT_ENABLED=false
