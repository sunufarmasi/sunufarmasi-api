' ==========================================
package "TRAÇABILITÉ" #FFEBEE {

    class AuditLog {
        - PK(id): Long
        - FK(utilisateurId): Long
        --
        - typeAction: String
        - entite: String
        - entiteId: Long
        - dateHeure: Timestamp
    }
}

' ==========================================
' PACKAGE ENUMERATION
' ==========================================
package "ENUMERATION" {

    enum RoleEnum {
        APPRENANT
        FORMATEUR
        ASSISTANT
        COMPTABLE
        RESPONSABLE_FINANCIER
        ADMINISTRATEUR
        DIRECTEUR
    }

    enum ModaliteEnum {
        PRESENTIEL
        EN_LIGNE
        HYBRIDE
    }

    enum StatutInscriptionEnum {
        EN_ATTENTE
        VALIDEE
        ANNULEE
    }

    enum StatutSessionEnum {
        BROUILLON
        PUBLIEE
        EN_COURS
        TERMINEE
        ANNULEE
    }

    enum ModePaiementEnum {
        ESPECES
        MOBILE_MONEY
        CHEQUE
        VIREMENT
    }

    enum StatutSeanceEnum {
        PLANIFIEE
        EN_COURS
        TERMINEE
        ANNULEE
    }


    enum StatutExonerationEnum {
        EN_ATTENTE
        VALIDEE
        REJETEE
    }

    enum TypeIdentificationEnum {
        CNI
        Passport
    }
}

' ==========================================
' RELATIONS D'HÉRITAGE (triangles clairs)
' ==========================================
Utilisateur <|-- Apprenant
Utilisateur <|-- Personnel


' ==========================================
' RELATIONS FORMATIONS
' ==========================================

' Formation contient SessionFormation (composition)
Formation "1" *-down- "0..*" SessionFormation : contient ▼

' SessionFormation décomposée en SeanceFormation (composition)
'SessionFormation "1" *-down- "0..*" SeanceFormation : décomposée en ▼

' SessionFormation liée à Lieu (agrégation - nullable)
'SessionFormation "0..*" o-right- "0..1" Lieu : se déroule à ▶

' Tables d'association Formateurs
'SessionFormation "1" -down- "0..*" SessionFormateur : formateurs ▼
'Formateur "1" -right- "0..*" SessionFormateur : assigné à ▶

' Tables d'association Assistants
'SessionFormation "1" -down- "0..*" SessionAssistant : assistants ▼
'Assistant "1" -right- "0..*" SessionAssistant : assigné à ▶

' SeanceFormation liée à Formateur
'SeanceFormation "0..*" -up- "1" Formateur : animée par ▲

' SeanceFormation liée à Lieu (agrégation)
'SeanceFormation "0..*" o-right- "0..1" Lieu : se déroule à ▶

' ==========================================
' RELATIONS INSCRIPTIONS
' ==========================================

' Apprenant effectue Inscription
Apprenant "1" -down- "0..*" Inscription : effectue ▼

' SessionFormation concerne Inscription
SessionFormation "1" -down- "0..*" Inscription : concerne ▼

' ==========================================
' RELATIONS FINANCIER
' ==========================================

' Inscription possède Paiement (composition 1:1)
Inscription "1" *-right- "1" Paiement : possède ▶

' Paiement composé de TranchePaiement (composition)
'Paiement "1" *-down- "0..*" TranchePaiement : composé de ▼

' Paiement génère Recu
'Paiement "1" -down- "0..*" Recu : génère ▼

' Comptable valide Paiement
Personnel "1" -down- "0..*" Paiement : valide ▼

' Inscription bénéficie Exoneration
'Inscription "1" -right- "0..1" Exoneration : bénéficie de ▶

' ResponsableFinancier impacte Exoneration
'Administrateur "1" -down- "0..*" Exoneration : impacte ▼

' Directeur valide Exoneration
'Administrateur "1" -down- "0..*" Exoneration : valide ▼

' ==========================================
' RELATIONS PÉDAGOGIQUE
' ==========================================

' SessionFormation contient DocumentPedagogique (composition)
SessionFormation "1" *-down- "0..*" DocumentPedagogique : contient ▼

' Utilisateur (Formateur/Assistant) dépose DocumentPedagogique
'Utilisateur "1" -down- "0..*" DocumentPedagogique : dépose ▼

' Apprenant reçoit Attestation
Apprenant "1" -down- "0..*" Attestation : reçoit ▼

' SessionFormation délivre Attestation
SessionFormation "1" -down- "0..*" Attestation : délivre ▼

' ResponsableFinancier génère Attestation
Personnel "1" -down- "0..*" Attestation : génère ▼

' ==========================================
' RELATIONS TRAÇABILITÉ
' ==========================================

' Utilisateur génère AuditLog
Utilisateur "1" -down- "0..*" AuditLog : génère ▼

' ==========================================
' NOTES EXPLICATIVES
' ==========================================

'note top of Utilisateur
'    <b>🔑 Classe Parent Abstraite</b>
'
'    7 rôles héritent de cette classe
'end note

'note right of SessionFormateur
'    <b>🔗 Association</b>
'
'    Formateurs → Sessions
'
'    • 1 formateur → N sessions
'    • 1 session → N formateurs
'    • 1 PRINCIPAL requis
'end note

'note right of SessionAssistant
'    <b>🔗 Association</b>
'
'    Assistants → Sessions
'
'    • 1 assistant → N sessions
'    • 1 session → N assistants
'end note

'note bottom of SeanceFormation
'    <b>📅 Séances</b>
'
'    Session décomposée en séances
'
'    <b>Modalité/séance:</b>
'    • PRESENTIEL → Lieu
'    • EN_LIGNE → Visio
'    • HYBRIDE → Les 2
'end note

'note right of Lieu
'    <b>📍 Lieux</b>
'
'    Pour sessions/séances
'    PRÉSENTIELLES
'
'    Nullable (défini après)
'end note

'note bottom of Inscription
'    <b>📋 Statuts</b>
'
'    • EN_ATTENTE
'    • VALIDEE
'    • ANNULEE
'end note

'note right of Paiement
'    <b>💳 Paiements</b>
'
'    • Complet
'    • Par tranches
'    • Exonérations
'
'    Modes: Espèces,
'    Mobile Money, etc.
'end note

'note bottom of DocumentPedagogique
'    <b>📚 Documents</b>
'
'    Déposé par:
'    Formateur/Assistant
'
'    Organisation:
'    Module/Chapitre
'
'    Accès: Si VALIDEE
'end note

legend right
    <b><size:15>🎨 LÉGENDE</size></b>
    ━━━━━━━━━━━━━━━━━━━━━

    <b>Packages:</b>
    <color:#E8F5E9>█</color> Utilisateurs
    <color:#E3F2FD>█</color> Formations
    <color:#FFF3E0>█</color> Financier
    <color:#F3E5F5>█</color> Pédagogique
    <color:#FFEBEE>█</color> Traçabilité

    <b>Relations:</b>
    *── Composition (contient)
    o── Agrégation (utilise)
    ── Association simple
    <|── Héritage

    <b>Directions:</b>
    ▲ Vers le haut
    ▼ Vers le bas
    ◀ Vers la gauche
    ▶ Vers la droite

    <b>Cardinalités:</b>
    1 = Exactement un
    0..1 = Zéro ou un
    0..* = Zéro ou plusieurs
endlegend

@enduml